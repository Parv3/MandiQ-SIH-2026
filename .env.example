# ==========================================
# MandiQ Environment Configuration
# ==========================================

# Database URL (Default: local SQLite database)
DATABASE_URL=sqlite+aiosqlite:///./mandiq.db

# ------------------------------------------
# Sarvam AI API Configuration
# Get your API key from: https://sarvam.ai
# ------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here

# ------------------------------------------
# Bhashini API Configuration (Govt. of India)
# Get credentials from: https://bhashini.gov.in / ULCA
# ------------------------------------------
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
